# Copy to .env and fill in. NEVER commit .env — credentials used to live in
# web.config / ClassLibrary/Class1.cs; they now come only from the environment.

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the React app).
CORS_ORIGINS=http://localhost:5173

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=10h

# ---- Main database (was ClassLibrary.con.connectionString) ----
# DB_DRIVER=tedious      -> SQL Server login (production)
# DB_DRIVER=msnodesqlv8  -> Windows auth, for local SQL Express dev boxes
DB_DRIVER=tedious
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# Only for msnodesqlv8; defaults to "ODBC Driver 17 for SQL Server"
DB_ODBC_DRIVER=

# ---- Optional fleet (FMS) database (was con.fleetconnection) ----
# The old app mirrored master inserts/updates/deletes to this DB. Leave
# FLEET_DB_NAME empty to disable mirroring (the old connection string was empty).
FLEET_DB_SERVER=
FLEET_DB_PORT=1433
FLEET_DB_NAME=
FLEET_DB_USER=
FLEET_DB_PASSWORD=

# Legacy app company code (was con.companyCode)
COMPANY_CODE=RELL

# Optional: absolute path to client/dist to serve the React app from this server
CLIENT_DIST=

# Where POD images are stored (default server/uploads/PODImage). During the changeover point this
# at the legacy site's wwwroot\PODImage so both applications show the same files.
POD_UPLOAD_DIR=
# Max size of one POD file in bytes (default 2 MB, as the legacy page)
POD_MAX_BYTES=

# Table-type names used by table-valued parameters (confirm from the schema script)
# TVP_MANIFEST_GRN=dbo.udt_Manifest_grn
# TVP_CHALLAN_MANIFEST=dbo.udt_Mainfest_no
# TVP_TRANSACTION=dbo.ud_Transaction_Details
# TVP_ARRIVAL_ENTRY=dbo.udt_Arrival_Entry
# TVP_DRS_GRN=dbo.udt_Drs_entry_details_grn
# TVP_POD_IMAGE=dbo.udt_Pod_Dispatch_image

# Branch where PODs are received (podreceive.aspx hard-coded B1001)
HEAD_OFFICE_BRANCH=B1001

# SQL request timeout in ms (default 120000)
DB_REQUEST_TIMEOUT=
