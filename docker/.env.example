# Settings for docker-compose.yml. Copy this file to ".env" in the project folder (next to docker-compose.yml)
# and fill in the passwords. NEVER commit .env.

# Ports on this PC: the app (http://localhost:8080) and SQL Server for SSMS (localhost,14330 — this PC only)
APP_PORT=8080
SQL_PORT=14330

# SQL Server "sa" password — 8+ characters with upper case, lower case, digits and a symbol (SQL Server refuses weaker ones)
MSSQL_SA_PASSWORD=
# Express is free (databases up to 10 GB). Developer = all features, not for production use.
MSSQL_PID=Express

# The application's database and its own SQL login (created on the first start; the API never uses sa)
DB_NAME=ramas
DB_USER=ramas_app
DB_PASSWORD=

# Long random string, 32+ characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=10h

COMPANY_CODE=RELL
HEAD_OFFICE_BRANCH=B1001

# First start only (when the database DB_NAME does not exist yet):
#   RAMAS_RESTORE_BAK=/backup/<file>.bak   restore that backup (put the file in docker/backup/) instead of a new database
#   RAMAS_DEMO=1                           new database: also load the demo data for the dashboard
RAMAS_RESTORE_BAK=
RAMAS_DEMO=0
